# Meta Model API (https://dev.meta.ai): one key for Muse Spark, Muse Image, Muse Wonder and Muse Voice Transcribe
LLM_API_KEY=
LLM_BASE_URL=https://api.meta.ai/v1
# Muse Spark writes the lesson and video script (muse-spark-1.3 is stronger but slower)
LLM_MODEL=muse-spark-1.1
LLM_API=responses
# Muse Image draws the video scenes
IMAGE_MODEL=muse-image-1.0
# Alternative: Meta's Llama API (chat completions)
# LLM_BASE_URL=https://api.llama.com/compat/v1/
# LLM_MODEL=Llama-4-Maverick-17B-128E-Instruct-FP8
# LLM_API=chat
# Optional for reasoning models on the chat API: low | medium | high
# LLM_REASONING_EFFORT=high
